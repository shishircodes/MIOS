GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set DATABASE_URL to use Neon PostgreSQL. Leave it BLANK to use the local
# SQLite file at DB_PATH (the offline default — tests always use SQLite).
#
# Neon Console > your project > Connection Details > "Connection string".
# Copy the URI form, NOT the psql command. It looks like:
#   postgresql://USER:PASSWORD@ep-NAME-123.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# Notes:
#  - Prefer the POOLED endpoint (hostname contains "-pooler") for the API.
#  - sslmode=require is added automatically if you omit it; Neon rejects plaintext.
#  - If the password contains @ : / or ?, percent-encode it (@ -> %40).
DATABASE_URL=

DB_PATH=data/mios.db

# Apify (used by scraper/pngworkforce.py)
APIFY_TOKEN=your-apify-token-here
PNGWORKFORCE_BASE_URL=https://www.pngworkforce.com/jobs/view-latest-jobs

# SEEK (scraper/seek.py). SEEK_PATHS is a comma-separated list of category
# landing paths; leave blank to use scraper.seek.DEFAULT_PATHS.
# Paths must be query-free and must not contain /job/ — au.seek.com's robots.txt
# disallows both, and scraper.seek rejects them at runtime.
SEEK_BASE_URL=https://au.seek.com
SEEK_PATHS=

# Adzuna (scraper/adzuna.py). A documented JSON API rather than HTML scraping,
# so there are no robots.txt carve-outs or terms-of-use tension to work around.
# Free key: https://developer.adzuna.com/ -> sign up -> create an application.
# Leave blank and this source is skipped; the other two still run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=au
# Comma-separated search terms. Blank = one query per watchlist company, which
# is the point of this source: targeted questions instead of a category browse.
ADZUNA_QUERIES=

# ---------------------------------------------------------------------------
# Google Sign-In (OAuth 2.0 / OIDC) - protects the web dashboard + API
# ---------------------------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add OAUTH_REDIRECT_URI below as an authorised
# redirect URI on that client, exactly as written.
# Paste the values whole - the client ID already ends in .apps.googleusercontent.com,
# so don't append it (a doubled suffix gives Google's "invalid_client" error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# If left blank a random one is minted per process (sessions drop on restart).
SESSION_SECRET=
SESSION_MAX_AGE=43200

# Where the API and web app live. OAUTH_REDIRECT_URI defaults to
# <API_BASE_URL>/auth/callback and must match the Google client exactly.
API_BASE_URL=http://localhost:8787
WEB_APP_URL=http://localhost:3000
OAUTH_REDIRECT_URI=

# Restrict who may sign in. ALLOWED_GOOGLE_DOMAIN is checked against the
# verified `hd` (hosted domain) claim in the ID token - set it to Easy Skill's
# Google Workspace domain so only company accounts get in.
ALLOWED_GOOGLE_DOMAIN=easyskill.com
# Optional comma-separated escape hatch for specific accounts (e.g. a student
# gmail during development). Leave blank in production.
ALLOWED_EMAILS=

# Dev-only bypass. When true the API skips auth entirely and the dashboard shows
# a warning banner. NEVER set this in a deployed environment.
AUTH_DISABLED=false
